{
  "name": "l22",
  "version": "1.0.0",
  "description": "Sistema de diseño UI para SolidJS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./l22.css": "./dist/l22.css",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit -p ./tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm run test && npm run build"
  },
  "keywords": [
    "solidjs",
    "ui",
    "design-system",
    "components"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@kobalte/core": "2.0.0-alpha.5"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.3",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.3",
    "@types/node": "^26.6.6",
    "solid-js": "^2.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  }
}
